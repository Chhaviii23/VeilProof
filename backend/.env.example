# VeilProof backend configuration — copy to backend/.env and adjust. NO REAL SECRETS here.
APP_ENV=development
RUN_PROFILE=demo

# Persistence: PostgreSQL is the design target. Local demo uses SQLite.
# DATABASE_URL=postgresql+psycopg://app:app@localhost:5432/veilproof
DATABASE_URL=postgresql://postgres:[veilproof@1231]@db.eptwmhofofsrgkxrnpek.supabase.co:5432/postgres

STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=backend/storage
ALLOWED_ORIGINS=http://localhost:8443,http://127.0.0.1:8443,http://localhost:5173

# Dev-only local key custody (generated on first run; ignored by git)
TRACKING_PEPPER_FILE=backend/keys/tracking_pepper.bin
KEY_BROKER_PRIVATE_KEY_FILE=backend/keys/broker_private.pem
KEY_BROKER_PUBLIC_KEY_FILE=backend/keys/broker_public.pem
KEY_BROKER_PUBLIC_KEY_ID=dev-broker-1
STAFF_SESSION_SECRET_FILE=backend/keys/session_secret.bin

# Staff auth (test-only local provider)
STAFF_AUTH_PROVIDER=local
STAFF_AUTH_ISSUER=veilproof-local
STAFF_AUTH_AUDIENCE=veilproof-staff
STAFF_SESSION_TTL_SECONDS=28800

# Proof backend: local_registry (default) or evm (requires RPC_URL + contract)
PROOF_BACKEND=local_registry
CHAIN_ID=80002
# RPC_URL=
# RELAYER_KEY_FILE=
# COMMITMENT_CONTRACT_ADDRESS=

DEMO_RESET_ENABLED=true
DEMO_ACCESS_DURATION_SECONDS=0

MAX_UPLOAD_BYTES=10485760
MAX_IMAGE_PIXELS=40000000
